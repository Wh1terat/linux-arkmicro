#!/bin/sh
export QTDIR=/usr
export QT_QPA_FONTDIR=$QTDIR/lib/qt/fonts
#export QT_QPA_PLATFORM=linuxfb:fb=/dev/fb0
export QT_QPA_PLATFORM=eglfs
export QT_QPA_EGLFS_INTEGRATION=eglfs_mali
export QT_QPA_EGLFS_DEBUG=0
#export QT_QPA_EGLFS_FORCEVSYNC=1
#export QT_QPA_EGLFS_FORCE888=1
export QT_QPA_PLATFORM_PLUGIN_PATH=$QTDIR/lib/qt/plugins
export QT_QPA_GENERIC_PLUGINS=evdevtouch:/dev/input/event0
export LD_LIBRARY_PATH=$QTDIR/lib:$LD_LIBRARY_PATH:$QTDIR/share/VRserver
export MALI_NOCLEAR=1
export MALI_MAX_WINDOW_BUFFERS=3

start() {
	eval `dbus-launch --auto-syntax`
	echo 190 > /sys/class/gpio/export
	echo out > /sys/class/gpio/gpio190/direction
	echo 1 > /sys/class/gpio/gpio190/value
	/usr/share/VRserver/vrserver /usr/share/VRserver/datapack /tmp cmn-CHN &
	echo "vrserver---- is start"
	Launcher &
	echo "Launcher is start"	
}

stop() {
	killall -9 Launcher
	echo "killall launcher!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
	killall -9 vrserver
	echo "killall vrserver!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
}

restart() {
	stop
	sleep 1
	start
}

case "$1" in
	start|stop|restart)
		"$1";;
	reload)
		# Restart, since there is no true "reload" feature.
		restart;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}"
		exit 1
esac
